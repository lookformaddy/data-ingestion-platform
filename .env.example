# Data Ingestion Platform — environment
# Copy to .env when running outside the defaults. No secrets are needed:
# every source in the demo is simulated in-process and all data is synthetic.

# Directory holding landing tables, checkpoints, outbox, DLQ and audit log.
INGEST_STATE_DIR=.ingest-state

# FastAPI service bind address / port.
INGEST_HOST=0.0.0.0
INGEST_PORT=8000
